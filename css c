/* Variáveis de Cores inspiradas no Kisuke Urahara */
:root {
    --bg-dark: #0d1411;          /* Verde-escuro quase preto */
    --bg-card: #15221c;          /* Verde musgo escuro (Haori) */
    --urahara-green: #245940;    /* Verde característico */
    --urahara-cream: #e8e4d5;    /* Creme do chapéu */
    --benihime-red: #c92a2a;     /* Vermelho da Zanpakutō */
    --text-main: #f1f3f2;
    --text-muted: #a3b3ac;
    --border-color: #2c473a;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    /* Padrão sutil inspirado nos triângulos do Haori */
    background-image: radial-gradient(var(--border-color) 1px, transparent 1px);
    background-size: 30px 30px;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 8%;
    background-color: rgba(13, 20, 17, 0.95);
    border-bottom: 2px solid var(--urahara-green);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(8px);
}

.logo {
    display: flex;
    flex-direction: column;
}

.kanji {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--urahara-cream);
    letter-spacing: 2px;
}

.sub-logo {
    font-size: 0.7rem;
    color: var(--urahara-green);
    font-weight: 700;
    letter-spacing: 1.5px;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-main);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--urahara-cream);
    border-bottom: 2px solid var(--benihime-red);
    padding-bottom: 4px;
}

/* Hero Section */
.hero {
    position: relative;
    height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 20px;
    background: linear-gradient(135deg, #0d1411 0%, #1b3b2b 50%, #0d1411 100%);
    border-bottom: 4px solid var(--urahara-cream);
}

.hero-content {
    max-width: 800px;
    z-index: 2;
}

.badge {
    display: inline-block;
    background-color: var(--urahara-green);
    color: var(--urahara-cream);
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
}

.hero h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--urahara-cream);
    letter-spacing: 4px;
    margin-bottom: 1rem;
    text-shadow: 0 4px 15px rgba(0,0,0,0.6);
}

.subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-style: italic;
}

/* Botões */
.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-primary, .btn-secondary {
    padding: 12px 28px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    font-size: 1rem;
}

.btn-primary {
    background-color: var(--urahara-green);
    color: var(--urahara-cream);
    border: 1px solid var(--urahara-cream);
}

.btn-primary:hover {
    background-color: var(--urahara-cream);
    color: var(--bg-dark);
}

.btn-secondary {
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--benihime-red);
}

.btn-secondary:hover {
    background-color: var(--benihime-red);
    color: white;
}

/* Estrutura de Conteúdo */
.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 20px;
}

.section {
    margin-bottom: 5rem;
}

.section-title {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    color: var(--urahara-cream);
    border-left: 5px solid var(--benihime-red);
    padding-left: 15px;
    margin-bottom: 1.5rem;
}

.section-desc {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
}

/* Seção Biografia */
.bio-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    align-items: start;
}

.bio-text p {
    margin-bottom: 1.2rem;
    color: #dce3df;
    font-size: 1.05rem;
}

.info-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--urahara-cream);
    padding: 1.8rem;
    border-radius: 6px;
}

.info-card h3 {
    font-family: 'Cinzel', serif;
    color: var(--urahara-cream);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
}

.info-card ul {
    list-style: none;
}

.info-card li {
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    color: var(--text-muted);
}

.info-card strong {
    color: var(--text-main);
}

/* Abas da Zanpakutō */
.tabs-container {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
}

.tab-buttons {
    display: flex;
    background-color: #0f1915;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
}

.tab-btn {
    flex: 1;
    padding: 1rem;
    background: none;
    border: none;
    color: var(--text-muted);
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
    font-size: 0.95rem;
}

.tab-btn:hover {
    color: var(--text-main);
    background-color: rgba(255, 255, 255, 0.03);
}

.tab-btn.active {
    color: white;
    background-color: var(--benihime-red);
}

.tab-content {
    display: none;
    padding: 2rem;
    animation: fadeIn 0.4s ease;
}

.tab-content.active {
    display: block;
}

.tab-content h3 {
    color: var(--urahara-cream);
    margin-bottom: 1rem;
    font-size: 1.3rem;
}

.ability-list {
    margin-top: 1rem;
    padding-left: 1.2rem;
}

.ability-list li {
    margin-bottom: 0.6rem;
    color: #dce3df;
}

/* Grid de Invenções */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
}

.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.8rem;
    border-radius: 6px;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.card:hover {
    transform: translateY(-5px);
    border-color: var(--urahara-cream);
}

.card-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--benihime-red);
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.card h3 {
    color: var(--urahara-cream);
    margin-bottom: 0.8rem;
    font-family: 'Cinzel', serif;
}

.card p {
    font-size: 0.95rem;
    color: var(--text-muted);
}

/* Citações */
.quote-box {
    background-color: var(--bg-card);
    border-left: 4px solid var(--urahara-green);
    padding: 2.5rem;
    border-radius: 6px;
    text-align: center;
}

blockquote {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--urahara-cream);
    margin-bottom: 1.5rem;
}

/* Footer */
footer {
    text-align: center;
    padding: 2.5rem;
    background-color: #090e0c;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
}

.footer-note {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--urahara-green);
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Responsividade */
@media (max-width: 768px) {
    .bio-grid {
        grid-template-columns: 1fr;
    }
    .nav-links {
        display: none;
    }
}
